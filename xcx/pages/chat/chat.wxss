.chat-page { display: flex; flex-direction: column; height: 100vh; }
.msg-list { flex: 1; padding: 20rpx; }
.msg-item { margin-bottom: 20rpx; }
.msg-bubble { background: #e8f4fd; padding: 16rpx 24rpx; border-radius: 12rpx; display: inline-block; font-size: 28rpx; }
.msg-time { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }
.input-bar { display: flex; padding: 16rpx 20rpx; background: #fff; border-top: 1rpx solid #eee; }
.chat-input { flex: 1; background: #f5f5f5; border-radius: 30rpx; padding: 12rpx 24rpx; font-size: 28rpx; }
.send-btn { background: #4A90D9; color: #fff; padding: 12rpx 24rpx; border-radius: 30rpx; margin-left: 16rpx; font-size: 28rpx; }
