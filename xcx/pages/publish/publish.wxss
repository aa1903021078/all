.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 28rpx; color: #333; display: block; margin-bottom: 8rpx; }
.form-input { background: #f5f5f5; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.form-input.picker { color: #666; }
.form-textarea { background: #f5f5f5; border-radius: 8rpx; padding: 16rpx 20rpx; font-size: 28rpx; width: 100%; height: 160rpx; box-sizing: border-box; }
.img-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.img-item { width: 160rpx; height: 160rpx; border-radius: 8rpx; }
.img-add { width: 160rpx; height: 160rpx; border: 2rpx dashed #ccc; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #ccc; }
