.category-page { display: flex; height: 100vh; }
.category-left { width: 180rpx; background: #fff; overflow-y: auto; }
.cat-item { padding: 30rpx 20rpx; text-align: center; font-size: 26rpx; border-bottom: 1rpx solid #eee; }
.cat-item.active { color: #4A90D9; font-weight: bold; background: #f5f5f5; border-left: 6rpx solid #4A90D9; }
.category-right { flex: 1; padding: 20rpx; overflow-y: auto; }
.book-card { display: flex; background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.book-cover { width: 120rpx; height: 160rpx; border-radius: 8rpx; margin-right: 16rpx; }
.book-info { flex: 1; display: flex; flex-direction: column; justify-content: space-around; }
.book-title { font-size: 28rpx; font-weight: bold; }
.book-author { font-size: 24rpx; color: #666; }
.book-condition { font-size: 24rpx; color: #4A90D9; }
.empty { text-align: center; padding: 80rpx 0; color: #999; }
