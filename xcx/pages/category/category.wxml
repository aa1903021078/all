<view class="category-page">
  <view class="category-left">
    <view class="cat-item {{currentCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="switchCategory" data-id="{{item.id}}">
      {{item.name}}
    </view>
  </view>
  <view class="category-right">
    <view class="book-card" wx:for="{{books}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="book-cover" src="{{item.coverImg}}" mode="aspectFill"></image>
      <view class="book-info">
        <text class="book-title">{{item.title}}</text>
        <text class="book-author">{{item.author}}</text>
        <text class="book-condition">品相: {{item.conditionLevel}}/10</text>
      </view>
    </view>
    <view wx:if="{{!books.length}}" class="empty">暂无图书</view>
  </view>
</view>
