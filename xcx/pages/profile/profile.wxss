.profile-header { display: flex; align-items: center; background: #4A90D9; padding: 40rpx 30rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; margin-right: 24rpx; border: 4rpx solid #fff; }
.user-info { color: #fff; }
.nickname { font-size: 34rpx; font-weight: bold; display: block; }
.credit { font-size: 26rpx; opacity: 0.9; display: block; margin-top: 8rpx; }
.status-tag { display: inline-block; font-size: 22rpx; background: rgba(255,255,255,0.3); padding: 4rpx 16rpx; border-radius: 20rpx; margin-top: 8rpx; }
.status-tag.pending { background: rgba(255,200,0,0.5); }
.menu-list { background: #fff; border-radius: 12rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.arrow { color: #ccc; }
.logout { margin-top: 40rpx; background: #ff4d4f; }
