<view class="container">
  <view class="card">
    <view class="form-item"><text class="label">昵称</text><input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" /></view>
    <view class="form-item"><text class="label">学号</text><input class="input" value="{{form.studentId}}" data-field="studentId" bindinput="onInput" /></view>
    <view class="form-item"><text class="label">姓名</text><input class="input" value="{{form.realName}}" data-field="realName" bindinput="onInput" /></view>
    <view class="form-item"><text class="label">学院</text><input class="input" value="{{form.college}}" data-field="college" bindinput="onInput" /></view>
    <view class="form-item"><text class="label">手机</text><input class="input" value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" /></view>
  </view>
  <view class="btn-primary" bindtap="submit">保存</view>
</view>
