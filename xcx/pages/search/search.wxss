.search-bar { display: flex; margin-bottom: 20rpx; }
.search-input { flex: 1; background: #fff; border-radius: 30rpx; padding: 14rpx 24rpx; font-size: 28rpx; }
.search-btn { background: #4A90D9; color: #fff; padding: 14rpx 24rpx; border-radius: 30rpx; margin-left: 16rpx; font-size: 28rpx; }
.book-card { display: flex; background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.book-cover { width: 120rpx; height: 160rpx; border-radius: 8rpx; margin-right: 16rpx; }
.book-info { flex: 1; display: flex; flex-direction: column; justify-content: space-around; }
.book-title { font-size: 30rpx; font-weight: bold; }
.book-author { font-size: 26rpx; color: #666; }
.book-condition { font-size: 24rpx; color: #4A90D9; }
.empty { text-align: center; padding: 100rpx 0; color: #999; }
