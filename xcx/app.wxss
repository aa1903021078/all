page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.container {
  padding: 20rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.btn-primary {
  background-color: #4A90D9;
  color: #fff;
  border-radius: 8rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
}
.btn-primary:active {
  opacity: 0.8;
}
